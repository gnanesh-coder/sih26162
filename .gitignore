.venv/
__pycache__/
*.py[cod]
*$py.class
.env
.pytest_cache/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet

# --- Reference GIS layers: derived, large, and re-buildable --------------
# The 1.8 GB OSM extract and everything extracted from it. Rebuild with
# src/ingestion/pbf_extractor.py; committing them would put a multi-gigabyte
# binary in every clone for data that is a download and a script away.
data/reference/*
!data/reference/.gitkeep
!data/reference/verified_events.csv

# The derived layers ARE committed, so a clone runs without a 1.8 GB download.
# They are geometry-only where the consumer reads only geometry, and brotli
# compressed: the forest layer went 126.9 -> 73.4 MB that way, under GitHub's
# 100 MB per-file limit, and 4,000 random point-in-polygon probes returned
# identical answers to the full-width original.
#
# The 1.8 GB PBF they come from stays out, as does the farmland layer, which
# was measured and rejected as a feature (0 of 2,000 verified crop burns fell
# inside a mapped farmland polygon).
!data/reference/industrial_boundaries_merged.parquet
!data/reference/osm_india_industrial_from_pbf.parquet
!data/reference/osm_india_forest_from_pbf.parquet
!data/reference/osm_india_responders_from_pbf.parquet

# --- Runtime state, not source ------------------------------------------
# The incident database is generated by the pipeline and, since the PostGIS
# migration, is only the offline-replay copy. Backups of it are working files.
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/*.sqlite.bak*

# Scratch and editor noise
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local editor / tooling config. .claude/launch.json is the dev-server entry
# for the browser preview -- useful on this machine, noise in a shared repo.
.claude/

# Superseded dashboard iterations. Git history already preserves anything worth
# recovering; keeping them in the tree just invites a reader to open the wrong
# index.html.
backups/

FIRMS_MAP_KEY=your_nasa_firms_key_here
INDIA_BBOX=68.0,6.5,97.5,35.5

# --- Database: PostGIS is the primary datastore ------------------------------
# Start it with:  docker compose up -d db
#
# Either set DATABASE_URL directly, or leave it unset and set the POSTGRES_*
# variables below -- docker-compose.yml reads the same names, so the server and
# the application cannot drift apart.
#
# A `postgresql://` URL is rewritten to the psycopg 3 driver automatically.
# DATABASE_URL=postgresql://sih:CHANGEME@localhost:5432/sih26162
POSTGRES_DB=sih26162
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Offline / demo fallback. Setting DATABASE_URL to a sqlite:// URL runs the
# system without a database server -- used by pytest and by Historical Replay
# Mode on a disconnected machine. It reports itself as `sqlite_fallback` at
# /api/v1/health, because concurrent writes serialise and spatial queries lose
# the GiST index.
# DATABASE_URL=sqlite:///data/fire_db.sqlite

# Copernicus Data Space Ecosystem (Sentinel-2 optical burn-scar validation).
# Free registration at https://dataspace.copernicus.eu -> create an OAuth client.
# Optional: without these, dNBR validation is skipped and reported as NO_CREDENTIALS.
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# --- Outbound alert dispatch -------------------------------------------------
# Dispatch is OFF unless this is explicitly true. Leave it unset for demos and
# pipeline replays: a run over a year of archived detections must not be able to
# page a control room. Unset, every channel reports DRY_RUN and builds the
# payload without sending it.
ALERT_DISPATCH_ENABLED=false

# Webhook. The only channel that needs no third-party account.
# ALERT_WEBHOOK_SECRET is optional; when set, each body is signed with
# HMAC-SHA256 in the X-SIH-Signature header so a receiver can verify the sender.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# Body format: "json" (default, for machine endpoints) or "text".
#
# Text mode POSTs the human-readable alert instead of JSON, with Title/Priority
# headers that push services such as ntfy.sh and Gotify use as the notification
# headline. That gives a real phone-delivery path over a channel that already
# works, with no account and no credential:
#
#   ALERT_WEBHOOK_URL=https://ntfy.sh/pick-an-obscure-topic-name
#   ALERT_WEBHOOK_FORMAT=text
#
# Then subscribe to that topic in the ntfy app. Note the topic is the only
# secret -- anyone who knows it can read your alerts -- so choose an unguessable
# one, and set ALERT_WEBHOOK_SECRET if the receiver can verify signatures.
#
# This does NOT make the SMS channel real. SmsChannel still reports
# NOT_IMPLEMENTED, because a push notification is not an SMS and saying
# otherwise would be a fabricated delivery receipt.
ALERT_WEBHOOK_FORMAT=json

# Email over SMTP with STARTTLS. ALERT_EMAIL_TO is comma-separated.

ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# SMS has no settings because no provider is wired. See SmsChannel.

# Processed corpus the API and compliance register read. Point this at the full
# national archive for a real deployment; the default is whatever a quick
# pipeline run last wrote, which under-reports every site in the register.
# The ANALYTICAL archive, read by /api/v1/map/hexes and
# /api/v1/compliance/register. This is not the live file: the automatic refresh
# always writes to data/processed/firms_industrial_joined.parquet, and refuses
# any write that would replace an archive with a live window.
PROCESSED_CORPUS=data/processed/firms_industrial_joined_12m.parquet

# --- Forest land cover -------------------------------------------------------
# The layer behind FOREST_FIRE. The problem statement asks for industrial fires
# to be segregated from forest fires, and radiometry cannot do it: a forest fire
# and a crop fire are both sustained open-ground combustion. Land cover decides.
#
# Build it once from the national OSM extract you already have:
#   python -m src.ingestion.pbf_extractor --layer forest
#
# Absent, the determination is simply withheld -- open-ground burns are reported
# exactly as the model classified them, and nothing else changes.
FOREST_COVER=data/reference/osm_india_forest_from_pbf.parquet

# --- Automatic FIRMS refresh -------------------------------------------------
# On by default. The dashboard ingests FIRMS, runs the spatial join and reseeds
# the incident database on this interval while it is running, so the freshness
# badge stays LIVE without anyone running a script. Set to 0/false to pin the
# data -- useful if you want a demonstration to be byte-identical every time.
#
# The interval floor is 30 minutes: FIRMS NRT publishes about 3 hours behind the
# overpass, so polling faster spends the map key's quota re-downloading what you
# already hold.
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_INTERVAL_MIN=180

# --- SMS ---------------------------------------------------------------------
# Three providers. Leave ALERT_SMS_PROVIDER unset and the channel reports
# NOT_CONFIGURED -- it never claims a delivery it did not make.
#
#   httpsms  free; turns your own Android handset into the gateway, so the
#            message leaves from a real Indian number. https://httpsms.com
#   twilio   the commercial default, if you have an account
#   generic  any gateway that takes an HTTP POST (Fast2SMS, MSG91, ...)
#
# Numbers are E.164 (+91...), comma-separated. They are masked to the last four
# digits in dispatch reports, because those reports go into the audit log and an
# audit trail should not become a directory of responders' phone numbers.
ALERT_SMS_PROVIDER=
ALERT_SMS_TO=
ALERT_SMS_FROM=

# httpsms: the API key from your httpsms.com dashboard.
ALERT_SMS_API_KEY=uk_QUuY2HHFlr4DD-JNivu47y0GoWMltFj1I8e3GPFjrjQrOfF0JLXCJd2iICDrFb87

# twilio
ALERT_TWILIO_ACCOUNT_SID=
ALERT_TWILIO_AUTH_TOKEN=

# generic: {to}, {from} and {text} are substituted into the template.
# Fast2SMS example:
#   ALERT_SMS_URL=https://www.fast2sms.com/dev/bulkV2
#   ALERT_SMS_AUTH_HEADER=authorization: YOUR_KEY
#   ALERT_SMS_BODY_TEMPLATE={"route":"q","numbers":"{to}","message":"{text}"}
ALERT_SMS_URL=
ALERT_SMS_AUTH_HEADER=
ALERT_SMS_BODY_TEMPLATE=
